{
  "manifest_version": 3,
  "name": "Farix AI \u2014 Veo Session",
  "version": "1.1.0",
  "description": "Securely launch managed Farix AI Veo sessions.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "management"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Farix AI",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "lockdown.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "100",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
