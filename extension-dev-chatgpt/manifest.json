{
  "manifest_version": 3,
  "name": "Farix AI — ChatGPT Session",
  "version": "1.0.0",
  "description": "Securely launch a managed Farix AI ChatGPT session.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "browsingData",
    "management"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Farix AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "100"
}