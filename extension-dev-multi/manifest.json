{
  "manifest_version": 3,
  "name": "Farix AI",
  "version": "1.0.0",
  "description": "One managed Farix AI extension for Veo 3 and Gemini Pro sessions.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "browsingData",
    "management"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://*.google.com/*",
    "https://myaccount.google.com/*",
    "https://accounts.google.com/*",
    "https://gemini.google.com/*",
    "https://farixai.com/*",
    "https://www.farixai.com/*",
    "https://farixai.lovable.app/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Farix AI",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://accounts.google.com/*",
        "https://myaccount.google.com/*"
      ],
      "js": [
        "gemini-lockdown.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*"
      ],
      "js": [
        "veo-lockdown.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://farixai.com/*",
        "https://www.farixai.com/*",
        "https://farixai.lovable.app/*"
      ],
      "js": [
        "farix-site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "100"
}
