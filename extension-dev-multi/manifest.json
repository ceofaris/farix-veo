{
  "manifest_version": 3,
  "name": "Farix AI",
  "version": "1.0.0",
  "description": "One managed Farix AI extension for Veo 3 and ChatGPT sessions.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "browsingData",
    "management"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Farix AI",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"],
      "js": ["chatgpt-lockdown.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://labs.google/*", "https://*.labs.google/*"],
      "js": ["veo-lockdown.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "100"
}
